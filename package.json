{
  "name": "novel-writer",
  "version": "1.0.32",
  "description": "소설가를 위한 워드프로세서",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "check:secrets": "node scripts/check-secrets.mjs",
    "server": "node server/server.mjs",
    "test:regress": "node tests/regress.mjs",
    "test:close": "node tests/electron-close.test.cjs"
  },
  "author": "lussion629-creator",
  "license": "ISC",
  "devDependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-font-family": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "cfb": "^1.2.2",
    "diff": "^9.0.0",
    "docx": "^9.9.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "hwp.js": "^0.0.3",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pako": "^3.0.2",
    "pdfjs-dist": "^4.10.38",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true,
  "type": "module",
  "productName": "소설 워드프로세서",
  "main": "electron/main.cjs",
  "build": {
    "appId": "io.github.lussion629-creator.novelwriter",
    "productName": "소설 워드프로세서",
    "artifactName": "NovelWriter-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "server/**"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "server/server.mjs",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "소설 워드프로세서",
      "language": "1042",
      "installerLanguages": [
        "ko_KR"
      ],
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "executableName": "NovelWriter",
    "publish": [
      {
        "provider": "github",
        "owner": "lussion629-creator",
        "repo": "SOSUL-CHANGJAK-PROGRAM",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lussion629-creator/SOSUL-CHANGJAK-PROGRAM.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  }
}
